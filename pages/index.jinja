---
title: jbisfun wiki
---
<h1 class="mb-3">{{ site.title }}</h1>
<p class="lead">READMEs, docs and API references for every repo in the workspace.</p>
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
{% for r in site.repos %}
  <div class="col">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h5 card-title mt-0"><a class="stretched-link text-decoration-none" href="{{ url(r.index) }}">{{ r.title }}</a></h2>
{% if r.description %}
        <p class="card-text">{{ r.description }}</p>
{% endif %}
        <p class="card-text small text-body-secondary mb-0 d-flex flex-wrap align-items-center gap-1">
          <code>{{ r.name }}</code>
          <span class="badge text-bg-secondary">{{ r.head[:7] }}</span>
{% if r.doc_pages %}
          <span class="badge text-bg-secondary">{{ r.doc_pages | length }} doc pages</span>
{% endif %}
{% for label in r.api_labels %}
          <span class="badge text-bg-secondary">{{ label }} API</span>
{% endfor %}
        </p>
      </div>
    </div>
  </div>
{% endfor %}
</div>
