---
title: jbisfun wiki
---
<h1 class="mb-3 d-flex align-items-center gap-3"><img src="{{ url('_assets/icons/icon-256.png') }}" alt="" width="72" height="72" class="wiki-logo wiki-logo-lg">{{ site.title }}</h1>
<p class="lead">{{ t('site-lead') }}</p>
{% for key, repos in site.repos | groupby("category_key") %}
<h2 class="h4 mt-5 mb-3">{{ repos[0].category }}</h2>
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
{% for r in repos %}
  <div class="col">
    <div class="card h-100" data-wiki-repo="{{ r.name }}">
      <div class="card-body d-flex flex-column">
        <h3 class="h5 card-title mt-0"><a class="stretched-link text-decoration-none" href="{{ url(r.index) }}">{{ r.title }}</a></h3>
{% if r.description %}
        <p class="card-text">{{ r.description }}</p>
{% endif %}
{% if r.doc_pages or r.api_labels %}
        <p class="card-text small mt-auto d-flex flex-wrap gap-1">
{% if r.doc_pages %}
          <span class="badge text-bg-secondary">{{ t('doc-pages', count=r.doc_pages | length) }}</span>
{% endif %}
{% for label in r.api_labels %}
          <span class="badge text-bg-secondary">{{ t('api-badge', label=label) }}</span>
{% endfor %}
        </p>
{% endif %}
      </div>
    </div>
  </div>
{% endfor %}
</div>
{% endfor %}
