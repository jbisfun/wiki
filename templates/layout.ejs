<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title %><% if (page.title !== site.title) { %> · <%= site.title %><% } %></title>
  <meta name="color-scheme" content="light dark">
  <script>
    // Follow the system light/dark preference; inline so the page never flashes the wrong theme.
    const scheme = matchMedia("(prefers-color-scheme: dark)");
    const applyScheme = () => (document.documentElement.dataset.bsTheme = scheme.matches ? "dark" : "light");
    applyScheme();
    scheme.addEventListener("change", applyScheme);
  </script>
  <link rel="stylesheet" href="<%= url('_assets/style.css') %>">
  <script type="module" src="<%= url('_assets/main.js') %>"></script>
</head>
<body>
<%- include('partials/navbar') %>
<div class="container-fluid">
  <div class="row">
<% if (repo) { %>
    <nav class="col-lg-3 col-xl-2 wiki-sidebar collapse d-lg-block border-end py-3" id="sidebar">
      <%- sidebar() %>
    </nav>
    <main class="col-lg-9 col-xl-8 py-4 px-lg-5 wiki-content"<% if (page.rel && page.rel.endsWith('.md') && !page.data.ejs) { %> data-radar-repo="<%= repo.name %>" data-radar-file="<%= page.rel %>"<% } %>>
<% } else { %>
    <main class="col-lg-10 col-xl-8 mx-auto py-4 wiki-content">
<% } %>
      <%- content %>
<%- include('partials/footer') %>
    </main>
  </div>
</div>
<% if (page.rel && page.rel.endsWith('.md') && !page.data.ejs) { %><%- include('partials/radar') %><% } %>
</body>
</html>
