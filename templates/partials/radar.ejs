<div class="dropdown" id="radar-menu">
  <button type="button" hidden data-bs-toggle="dropdown" aria-expanded="false"></button>
  <div class="dropdown-menu shadow" style="max-width: 32rem">
    <h6 class="dropdown-header">Add to Radar</h6>
    <code class="d-block px-3 pb-2 small text-break" data-radar-command></code>
    <button type="button" class="dropdown-item" data-radar-copy>Copy command</button>
    <button type="button" class="dropdown-item" data-radar-copy="note">Copy command with note</button>
  </div>
</div>
