<ul class="list-unstyled">
<% if (repo.readmePage) { %>
  <li><a href="<%= url(repo.index) %>">README</a></li>
<% } %>
<% if (repo.web) { %>
  <li><a href="<%= repo.web %>">Source on GitHub</a></li>
<% } %>
</ul>
<% if (repo.apis.length) { %>
<h1>Code reference</h1>
<ul class="list-unstyled">
<% for (const a of repo.apis) { %>
  <li><a href="<%= url(a.out) %>"><%= a.title %></a> <span class="badge text-bg-secondary"><%= a.label %></span></li>
<% } %>
</ul>
<% } %>
<% if (repo.docPages.length) { %>
<h1><%= repo.bookTitle ?? 'Docs' %></h1>
<% if (!repo.summary && repo.tree.page) { %>
<ul class="list-unstyled"><li><a href="<%= url(repo.tree.page.out) %>"><%= repo.tree.page.title %></a></li></ul>
<% } %>
<%- docs %>
<% } %>
